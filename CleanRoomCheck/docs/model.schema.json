{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CleanRoomCheck model 1.0",
  "description": "Structural schema only. Runtime checks reference integrity, duplicates, semantic consistency and budgets.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 0,
      "maxItems": 2000
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "minItems": 1,
      "maxItems": 500
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      },
      "minItems": 0,
      "maxItems": 2000
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenario"
      },
      "minItems": 1,
      "maxItems": 16
    },
    "assessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assessment"
      },
      "minItems": 1,
      "maxItems": 50
    }
  },
  "required": [
    "schema_version",
    "project",
    "evidence",
    "nodes",
    "edges",
    "scenarios",
    "assessments"
  ],
