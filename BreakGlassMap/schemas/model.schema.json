{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:breakglassmap:model:1",
  "title": "BreakGlassMap model v1",
  "$comment": "The runtime validator additionally checks reference existence, duplicate IDs, nonblank strings, valid dates, disjoint overrides, expression depth 12, total refs 8000, input size 1 MiB, and control characters.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "minLength": 0,
      "maxLength": 4000
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250,
      "items": {
        "$ref": "#/$defs/node"
      },
      "contains": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "goal"
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "nodes"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^(?!(?:constructor|prototype|__proto__)$)[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ref": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [
            "ref"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "maxItems": 250,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          },
          "required": [
            "all"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "maxItems": 250,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          },
          "required": [
            "any"
          ]
        }
      ]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "requires": {
          "$ref": "#/$defs/expression"
        }
      },
      "required": [
        "id",
        "label",
        "requires"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "not-tested",
            "passed",
            "failed"
          ]
        },
        "checkedAt": {
          "type": "string",
          "format": "date"
        },
        "reviewer": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160
        },
        "reference": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "scope": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160
        },
        "conditionHash": {
          "type": "string",
          "pattern": "^bgm1-[a-f0-9]{16}$"
        },
        "maxAgeDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        }
      },
      "required": [
        "status"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "passed",
                  "failed"
                ]
              }
            }
          },
          "then": {
            "required": [
              "checkedAt",
              "reviewer",
              "reference",
              "scope"
            ],
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            }
          }
        }
      ]
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "category": {
              "enum": [
                "identity",
                "network",
                "credential",
                "document",
                "people",
                "system",
                "other"
              ]
            },
            "owner": {
              "type": "string",
              "minLength": 0,
              "maxLength": 160
            },
            "systemId": {
              "type": "string",
              "minLength": 0,
              "maxLength": 120
            },
            "notes": {
              "type": "string",
              "minLength": 0,
              "maxLength": 2000
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            },
            "kind": {
              "const": "resource"
            },
            "initial": {
              "enum": [
                "available",
                "unavailable",
                "unknown"
              ]
            }
          },
          "required": [
            "id",
            "label",
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "category": {
              "enum": [
                "identity",
                "network",
                "credential",
                "document",
                "people",
                "system",
                "other"
              ]
            },
            "owner": {
              "type": "string",
              "minLength": 0,
              "maxLength": 160
            },
            "systemId": {
              "type": "string",
              "minLength": 0,
              "maxLength": 120
            },
            "notes": {
              "type": "string",
              "minLength": 0,
              "maxLength": 2000
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            },
            "kind": {
              "enum": [
                "action",
                "goal"
              ]
            },
            "routes": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/route"
              }
            }
          },
          "required": [
            "id",
            "label",
            "kind"
          ]
        }
      ]
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "unavailable": {
          "type": "array",
          "maxItems": 250,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "unknown": {
          "type": "array",
          "maxItems": 250,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "required": [
        "id",
        "name"
      ]
    }
  }
}
